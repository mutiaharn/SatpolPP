# ==============================================================================
# SATPOL PP SULSEL & SIAP TERTIB - INFRASTRUCTURE ENVIRONMENT TEMPLATE
# Salin file ini menjadi .env di direktori deployments/ sebelum menjalankan Docker
# ==============================================================================

# --- Application ---
APP_ENV=production
APP_PORT=8080
TZ=Asia/Makassar

# --- Security & Encryption (WAJIB GANTI DENGAN SECRET ACAK) ---
JWT_SECRET=change-this-to-cryptographically-secure-random-64-char-string
# 32-byte Hex Key (64 karakter hex) untuk enkripsi AES-256-GCM data PII (NIK & No HP)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- PostgreSQL Database ---
POSTGRES_DB=satpolpp_sulsel_db
POSTGRES_USER=satpolpp_app
POSTGRES_PASSWORD=change-this-strong-postgres-password

# --- PgBouncer (Transaction Pooling) ---
DB_DRIVER=postgres
DB_HOST=pgbouncer
DB_PORT=6432
DB_USER=satpolpp_app
DB_PASS=change-this-strong-postgres-password
DB_NAME=satpolpp_sulsel_db
DB_SSLMODE=disable

# --- Prisma Direct Connection (Bypass PgBouncer untuk DDL Migration) ---
DATABASE_URL=postgresql://satpolpp_app:change-this-strong-postgres-password@postgres:5432/satpolpp_sulsel_db?schema=public

# --- RustFS Object Storage (S3 Compatible) ---
RUSTFS_ROOT_USER=satpol_s3_admin
RUSTFS_ROOT_PASSWORD=change-this-strong-rustfs-password
S3_ENDPOINT=http://rustfs:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=satpol_s3_admin
S3_SECRET_KEY=change-this-strong-rustfs-password
S3_BUCKET_EVIDENCE=siaptertib-evidence
S3_BUCKET_DOCUMENTS=portal-documents
S3_BUCKET_MEDIA=portal-media
S3_USE_SSL=false

# --- SMTP Email Sender (Resi Tiket SIAP TERTIB) ---
# Production: gunakan SMTP Diskominfo (mail.sulselprov.go.id:587) atau SMTP Relay
# Development (docker-compose.dev.yml): otomatis diarahkan ke mailpit:1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@satpolpp.sulselprov.go.id
SMTP_DOMAIN=satpolpp.sulselprov.go.id

# --- Domain & Frontend Public URL ---
PUBLIC_SITE_URL=https://satpolpp.sulselprov.go.id
