# Multi-stage Dockerfile for SvelteKit Frontend (Monorepo Context + Non-Root)
FROM node:20-alpine AS builder

WORKDIR /workspace
COPY frontend/package*.json ./frontend/
RUN cd frontend && npm ci

COPY contracts ./contracts
COPY frontend ./frontend
RUN cd frontend && npm run build

# Runtime Stage
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /workspace/frontend/package*.json ./
COPY --from=builder /workspace/frontend/build ./build
COPY --from=builder /workspace/frontend/static ./static
COPY --from=builder /workspace/frontend/node_modules ./node_modules

RUN chown -R node:node /app
USER node

EXPOSE 3000
CMD ["node", "build"]
