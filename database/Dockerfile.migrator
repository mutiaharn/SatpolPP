# One-Shot Prisma Database Migrator Image
FROM node:20-alpine

WORKDIR /app
RUN apk add --no-cache openssl

COPY package.json ./
RUN npm install --omit=dev

COPY prisma ./prisma

# Default command pushes schema safely or runs committed migrations (no JS client needed for Go backend)
CMD ["sh", "-c", "if [ -d prisma/migrations ] && [ \"$(ls -A prisma/migrations 2>/dev/null)\" ]; then npx prisma migrate deploy; else npx prisma db push --skip-generate --accept-data-loss=false; fi"]
